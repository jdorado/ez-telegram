{
  "name": "@jc_stack/ez-telegram",
  "version": "0.1.0-beta.11.rc.1",
  "description": "Telegram group channel for Ez agents: post to a group or topic, read its messages, keep durable receipts",
  "type": "module",
  "license": "MIT",
  "engines": {"node": ">=22.23.4"},
  "packageManager": "pnpm@10.30.3",
  "bin": {"ez-telegram": "bin/ez-telegram.mjs"},
  "files": ["bin", "src", "skills", "test", "Dockerfile", ".dockerignore", "ez-plugin.json", "ez-deployment.json", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "pnpm-workspace.yaml"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "pnpm test && node --check src/cli.mjs && node --check src/service.mjs && node --check src/store.mjs"
  },
  "publishConfig": {"access": "public", "tag": "latest"},
  "repository": {"type": "git", "url": "git+https://github.com/jdorado/ez-telegram.git"},
  "ezRelease": {"protocol": 1, "kind": "plugin", "stateSchema": 1, "mainProtocol": 1}
}
